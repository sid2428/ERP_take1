# Copy to .env (local Docker database) and/or .env.supabase (Supabase). Both are gitignored.

# ---- Owner connection: migrations, bulk loads, verification scripts ----
#   Local:    postgres://postgres:<password>@localhost:54329/erp
#   Supabase: Dashboard -> Connect -> "Session pooler" URI (IPv4, port 5432)
DATABASE_URL=postgres://postgres:<password>@localhost:54329/erp
# "false" only for the local Docker database; Supabase requires SSL.
DATABASE_SSL=false

# ---- Web app connection (least-privilege erp_app role) ----
# Password set with npm run db:app-password / supabase:app-password (16+ characters).
APP_DB_PASSWORD=<generate-a-long-random-password>
#   Local:    postgres://erp_app:<APP_DB_PASSWORD>@localhost:54329/erp
#   Supabase: generated by npm run supabase:app-url (transaction pooler, port 6543)
APP_DATABASE_URL=postgres://erp_app:<APP_DB_PASSWORD>@localhost:54329/erp

# ---- Web app ----
SESSION_SECRET=<at-least-32-random-characters>
PORT=3100

# ---- Account seeding (npm run data:users) ----
DEMO_PASSWORD=<password for the demo student and faculty accounts>
ADMIN_PASSWORD=<password for the admin account>
