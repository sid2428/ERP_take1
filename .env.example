# Copy this file to .env, replace every replace-with-* value with your own local value, and keep
# .env private. Production values live in Vercel environment variables.

# Owner connection: migrations and bulk loads
DATABASE_URL=postgres://postgres:replace-with-local-database-password@localhost:54329/erp
DATABASE_SSL=false

# Least-privilege role used by the web app (password set with npm run db:app-password)
APP_DB_PASSWORD=replace-with-local-app-db-password
APP_DATABASE_URL=postgres://erp_app:replace-with-local-app-db-password@localhost:54329/erp

SESSION_SECRET=replace-with-a-long-random-session-secret
DEMO_PASSWORD=replace-with-local-demo-password
ADMIN_PASSWORD=replace-with-local-admin-password
PORT=3100
