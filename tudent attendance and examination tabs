[32m+[m[32mCREATE OR REPLACE VIEW v_attendance_defaulters_by_division AS[m
[32m+[m[32mWITH student_attendance AS ([m
[32m+[m[32m  SELECT student_id, academic_session_id,[m
[32m+[m[32m         sum(total_sessions)::int AS total_sessions,[m
[32m+[m[32m         sum(attended)::int AS attended,[m
[32m+[m[32m         round(100.0 * sum(attended) / NULLIF(sum(total_sessions), 0), 2) AS attendance_pct[m
[32m+[m[32m  FROM attendance_summary[m
[32m+[m[32m  WHERE academic_session_id = current_session_id()[m
[32m+[m[32m  GROUP BY student_id, academic_session_id[m
[32m+[m[32m)[m
[32m+[m[32mSELECT d.division_id, d.division_code, d.academic_session_id,[m
[32m+[m[32m       count(ss.student_id)::int AS student_count,[m
[32m+[m[32m       count(*) FILTER (WHERE COALESCE(sa.attendance_pct, 0) < 75)::int AS defaulter_count,[m
[32m+[m[32m       round(100.0 * count(*) FILTER (WHERE COALESCE(sa.attendance_pct, 0) < 75)[m
[32m+[m[32m         / NULLIF(count(ss.student_id), 0), 2) AS defaulter_percentage[m
[32m+[m[32mFROM division d[m
[32m+[m[32mJOIN student_section ss[m
[32m+[m[32m  ON ss.division_id = d.division_id[m
[32m+[m[32m AND ss.academic_session_id = d.academic_session_id[m
[32m+[m[32mLEFT JOIN student_attendance sa[m
[32m+[m[32m  ON sa.student_id = ss.student_id[m
[32m+[m[32m AND sa.academic_session_id = ss.academic_session_id[m
[32m+[m[32mWHERE d.academic_session_id = current_session_id()[m
[32m+[m[32mGROUP BY d.division_id, d.division_code, d.academic_session_id[m
[32m+[m[32mHAVING count(*) FILTER (WHERE COALESCE(sa.attendance_pct, 0) < 75) > 0;[m
