# The fee app uses the same-origin finance router at /student/fee/api.
# Local Vite requests are proxied to the ERP server on port 3100.
VITE_API_BASE_URL=/student/fee/api
# Set to true to browse the UI with built-in sample data and NO backend.
# Payments and top-ups are disabled in this mode (they need your backend + Razorpay).
VITE_USE_SAMPLE_DATA=false
