<%- include('head') %>
<body>
<div class="app">
<% const currentUser = typeof user === 'undefined' ? null : user; %>
<% if (currentUser) { %>
<aside class="side" id="sidebar" aria-label="Main navigation">
  <a class="brand" href="/"><div class="logo">P</div><div>PICT <%= { student: 'Student Portal', faculty: 'Faculty Portal', admin: 'Academic Console' }[currentUser.role] %></div></a>
  <% for (const group of NAV[currentUser.role]) { %>
    <div class="grp"><%= group.label %></div>
    <% for (const item of group.items) { %>
      <a class="nav-link<%= nav === item.key ? ' on' : '' %>" href="<%= item.href %>"<%- nav === item.key ? ' aria-current="page"' : '' %>><%- include('icon', { name: item.icon }) %><%= item.label %></a>
    <% } %>
  <% } %>
</aside>
<% } %>
<div class="col">
<% if (currentUser) { %>
<header class="top">
  <button class="menu-btn" type="button" data-menu aria-controls="sidebar" aria-expanded="false"><%- include('icon', { name: 'menu', size: 18 }) %><span class="sr-only">Menu</span></button>
  <% if (currentUser.role === 'admin') { %>
    <form class="search" action="/admin/students" method="get" role="search">
      <%- include('icon', { name: 'search', size: 15 }) %>
      <label class="sr-only" for="top-search">Search students</label>
      <input id="top-search" type="search" name="q" placeholder="Search students by name or number">
    </form>
  <% } %>
  <div class="sp"></div>
  <% if (currentSession) { %><span class="term" title="Current academic session"><%= currentSession.session_name %></span><% } %>
  <details class="me-menu">
    <summary class="me">
      <div class="av"><%= fmt.initials(currentUser.displayName) %></div>
      <div class="who-text"><strong><%= currentUser.displayName %></strong><small><%= currentUser.loginId %></small></div>
    </summary>
    <div class="drop">
      <a href="/<%= currentUser.role %><%= currentUser.role === 'admin' ? '' : '/profile' %>"><%= currentUser.role === 'admin' ? 'Dashboard' : 'My profile' %></a>
      <a href="/account/password">Change password</a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out</button></form>
    </div>
  </details>
</header>
<% } %>
<main id="content">
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash <%= flash.type %>" role="status"><%= flash.text %></div>
<% } %>