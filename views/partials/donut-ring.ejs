<% const ringValue = Number(value); const ringMax = Number(maximum);
   const ratio = Number.isFinite(ringValue) && Number.isFinite(ringMax) && ringMax > 0
     ? Math.max(0, Math.min(100, ringValue / ringMax * 100)) : 0;
%><div class="ui-ring-wrap"><svg class="ui-ring" viewBox="0 0 100 100" role="img" aria-label="<%= label %>: <%= displayValue %>">
  <circle class="ui-ring-track" cx="50" cy="50" r="40" pathLength="100"/>
  <circle class="ui-ring-value" cx="50" cy="50" r="40" pathLength="100" stroke-dasharray="<%= ratio %> 100"/>
  <text x="50" y="53" text-anchor="middle"><%= displayValue %></text>
</svg><span class="ui-label"><%= label %></span></div>
