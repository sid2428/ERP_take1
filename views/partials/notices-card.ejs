<%# Dashboard card: latest notices for this user. Locals: notices ({ latest, unread }), noticeBase %>
<div class="card" data-notification-board>
  <div class="hd"><h2><%= noticeBase.endsWith('/inbox') ? 'Inbox' : 'Notices' %></h2><% if (notices.unread) { %><span class="pill o"><%= notices.unread %> unread</span><% } %></div>
  <% for (const a of notices.alerts) { %>
  <div class="item">
    <span class="dot <%= a.severity === 'high' ? 'r' : '' %>"></span>
    <div class="t"><div><a href="<%= a.link || noticeBase %>"><%= a.title %></a></div>
      <div class="s"><%= a.kind === 'fees' ? a.body : 'See the courses on your notices page' %></div></div>
  </div>
  <% } %>
  <% if (!notices.latest.length && !notices.alerts.length) { %>
    <p class="empty">No notices for you right now.</p>
  <% } %>
  <% for (const n of notices.latest) { %>
  <% const itemPath = n.item_type === 'notification' ? `${noticeBase}/notification/${n.notification_id}` : `${noticeBase}/${n.notice_id}`; %>
  <article class="item notice-summary-item<%= n.is_read ? '' : ' unread' %>">
    <div class="t">
      <div class="notice-summary-title">
        <% if (n.notification_kind === 'grievance') { %><span class="pill v">Grievance</span> <% } %>
        <a href="<%= itemPath %><%= n.link ? '/go' : '' %>"><%= n.is_important ? '★ ' : '' %><%= n.title %></a>
        <% if (!n.is_read) { %> <span class="dot b inline" title="Unread" aria-label="Unread"></span><% } %>
      </div>
      <% if (n.is_personal) { %><div class="s notice-summary-body"><%= n.body %></div><% } %>
      <div class="s"><%= n.category %> · <%= n.posted_by_name %><% if (n.is_personal) { %> · <span class="pill <%= n.is_read ? 'n' : 'o' %>"><%= n.is_read ? 'Read' : 'Unread' %></span><% } %></div>
    </div>
    <time class="w" datetime="<%= new Date(n.posted_at).toISOString() %>"><%= fmt.shortDate(n.posted_at) %></time>
  </article>
  <% } %>
  <div style="margin-top:10px"><a href="<%= noticeBase %>"><%= noticeBase.endsWith('/inbox') ? 'Open inbox' : 'All notices' %> →</a></div>
</div>
