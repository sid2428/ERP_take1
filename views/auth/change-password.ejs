<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Change password</h1></div>
<% if (forced) { %>
  <div class="flash info">Welcome! Before you continue, please replace your initial password with one only you know.</div>
<% } %>
<% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>
<section class="card" style="max-width:520px">
  <form method="post" action="/account/password" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="cp">Current password</label><input id="cp" type="password" name="current_password" autocomplete="current-password" required></div>
    <div class="field"><label for="np">New password</label><input id="np" type="password" name="new_password" autocomplete="new-password" minlength="8" required>
      <span class="hint">At least 8 characters, with a letter and a number. Not your login ID or date of birth.</span></div>
    <div class="field"><label for="cf">Confirm new password</label><input id="cf" type="password" name="confirm_password" autocomplete="new-password" required></div>
    <div class="actions"><button class="btn primary" type="submit">Save password</button>
      <% if (!forced) { %><a class="btn" href="/">Cancel</a><% } %></div>
  </form>
</section>
<%- include('../partials/layout-end') %>
