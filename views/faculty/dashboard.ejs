<%- include('../partials/layout-start') %>
<%
  const p = profile;
  const fullName = (p.qualification === 'Ph.D.' ? 'Dr. ' : 'Prof. ') + p.first_name + ' ' + p.last_name;
%>
<h1>Dashboard</h1>

<section class="hero">
  <svg class="deco" width="420" height="420" viewBox="0 0 420 420" aria-hidden="true"><circle cx="210" cy="210" r="90"/><circle cx="210" cy="210" r="140"/><circle cx="210" cy="210" r="190"/></svg>
  <div class="hr">
    <div class="who">
      <div class="big"><%= fmt.initials(p.first_name + ' ' + p.last_name) %></div>
      <div style="min-width:0">
        <div class="name"><%= fullName %></div>
        <div class="sub"><%= p.designation %> · <%= p.dept_name %></div>
        <div class="tags">
          <span class="tag ok"><%= p.status %></span>
          <span class="tag">Primary faculty · <%= classes.length %> classes</span>
          <% if (p.is_hod) { %><span class="tag hod">Head of Department (HOD)</span><% } %>
        </div>
        <div class="kv">
          <div><small>Faculty code</small><span><%= p.faculty_code %></span></div>
          <div><small>Joined</small><span><%= fmt.date(p.date_of_joining) %></span></div>
          <div><small>Contact</small><span><%= p.mobile_number || '—' %></span></div>
        </div>
      </div>
    </div>
    <div class="termbox">
      <div class="l">
        <div><%= currentSession ? currentSession.session_name : 'Academic Term' %></div>
        <div><% if (progress) { %>Week <%= progress.week %> of <%= progress.totalWeeks %> · <%= progress.pct %>% complete · <%= progress.daysLeft %> days left<% } else { %>Active session<% } %></div>
      </div>
      <p><%= currentSession ? `${fmt.date(currentSession.start_date)} → ${fmt.date(currentSession.end_date)}` : '' %> · <%= stats.weeklyHours %> scheduled teaching hours / week</p>
    </div>
  </div>
  <div class="facts">
    <div><small>Avg class attendance</small><span><%= stats.avgAttendance != null ? fmt.pct(stats.avgAttendance, 1) : '—' %></span></div>
    <div><small>Teaching classes</small><span><%= classes.length %></span></div>
    <div><small>Pending leave</small><span><%= pendingLeaves %> request<%= pendingLeaves === 1 ? '' : 's' %></span></div>
    <div><small>Latest payroll</small><span><%= latestPayslip ? `${latestPayslip.period_text} · ${latestPayslip.status}` : '—' %></span></div>
  </div>
</section>

<section class="cards">
  <div class="card">
    <div class="hd"><h2>Average class attendance</h2></div>
    <div class="note">Orange tick marks the 75% minimum</div>
    <div class="kpi"><%= stats.avgAttendance != null ? fmt.pct(stats.avgAttendance, 1) : '—' %></div>
    <div class="bar"><% if (stats.avgAttendance != null) { %><i class="<%= stats.avgAttendance < 75 ? 'bad' : stats.avgAttendance < 80 ? 'warn' : '' %>" style="width:<%= stats.avgAttendance %>%"></i><% } %><u style="left:75%"></u></div>
    <div class="sm"><%= stats.avgAttendance != null && stats.avgAttendance >= 75 ? `${(stats.avgAttendance - 75).toFixed(1)} points above institutional minimum` : 'Attendance threshold monitoring active' %></div>
  </div>

  <div class="card">
    <div class="hd"><h2>Attendance by course</h2></div>
    <div class="note"><%= courseBars.length ? `${courseBars.length} assigned offerings` : 'No active offerings' %></div>
    <% for (const c of courseBars) { %>
      <div class="row" title="<%= c.code %> · <%= c.name %>">
        <span><%= c.code %> · <%= c.name %></span>
        <div class="bar"><i class="<%= c.pct < 75 ? 'bad' : '' %>" style="width:<%= c.pct %>%"></i><u style="left:75%"></u></div>
        <b><%= fmt.pct(c.pct) %></b>
      </div>
    <% } %>
  </div>

  <div class="card">
    <div class="hd"><h2>Leave balance · 2026</h2><a href="/faculty/leave">Manage leave</a></div>
    <div class="note">Annual quota minus approved days</div>
    <% if (leaveBalances && leaveBalances.length) { %>
      <% for (const b of leaveBalances) { %>
        <div class="row">
          <span><%= b.leave_name %></span>
          <div class="bar"><i style="width:<%= Math.min(100, Math.round((Number(b.balance_days) / (b.annual_quota || 1)) * 100)) %>%"></i></div>
          <b><%= b.balance_days %> / <%= b.annual_quota %> d</b>
        </div>
      <% } %>
    <% } else { %>
      <div class="empty">No leave quotas defined.</div>
    <% } %>
    <div class="sm"><%= pendingLeaves > 0 ? `${pendingLeaves} leave request awaiting approval` : 'All leave balances up to date' %></div>
  </div>

  <div class="card">
    <div class="hd"><h2>Latest payroll</h2><a href="/faculty/payroll">View payslips</a></div>
    <div class="note"><%= latestPayslip ? latestPayslip.period_text : 'Current financial year' %></div>
    <% if (latestPayslip) { %>
      <div class="kpi" style="color:var(--green)"><%= fmt.num(latestPayslip.net_salary) %> <small>INR</small></div>
      <div class="row" style="margin-top:12px">
        <span>Basic + Allowances</span>
        <b><%= fmt.num(Number(latestPayslip.basic_salary) + Number(latestPayslip.allowances)) %></b>
      </div>
      <div class="row">
        <span>Total deductions</span>
        <b style="color:var(--red)">- <%= fmt.num(Number(latestPayslip.deductions) + Number(latestPayslip.leave_deductions)) %></b>
      </div>
      <div class="sm" style="display:flex;justify-content:space-between;align-items:center;margin-top:8px">
        <span>Status: <span class="pill <%= latestPayslip.status === 'PAID' ? 'g' : (latestPayslip.status === 'APPROVED' ? 'o' : 'n') %>"><%= latestPayslip.status %></span></span>
        <% if (latestPayslip.paid_at) { %><span>Paid on <%= fmt.shortDate(latestPayslip.paid_at) %></span><% } %>
      </div>
    <% } else { %>
      <div class="empty">No payslip generated yet.</div>
    <% } %>
  </div>
</section>

<div class="grid2">
  <section class="card t">
    <div class="hd">
      <h2>Courses taught · <%= currentSession ? currentSession.session_name : 'Current term' %></h2>
      <a href="/faculty/classes">All teaching classes</a>
    </div>
    <div class="sc">
      <table>
        <thead>
          <tr>
            <th>Code</th>
            <th>Course</th>
            <th>Class / Batch</th>
            <th>Type</th>
            <th class="num">Students</th>
            <th class="num">Held</th>
            <th>Avg attendance</th>
            <th>Below 75%</th>
          </tr>
        </thead>
        <tbody>
          <% if (!classes.length) { %>
            <tr><td colspan="8" class="empty">No teaching classes assigned for this term.</td></tr>
          <% } %>
          <% for (const c of classes) { %>
            <tr>
              <td class="code"><%= c.course_code %></td>
              <td><a href="/faculty/classes/<%= c.assignment_id %>"><%= c.course_name %></a></td>
              <td class="nw"><%= c.batch_code || c.class_label %></td>
              <td><span class="pill<%= c.session_type === 'Lab' ? ' g' : '' %>"><%= c.session_type %></span></td>
              <td class="num"><%= c.students %></td>
              <td class="num"><%= c.sessions_held %></td>
              <td><%- include('../partials/pct-bar', { value: c.avg_pct, min: c.min_attendance_pct }) %></td>
              <td>
                <% if (c.below_min) { %>
                  <a class="pill o" href="/faculty/classes/<%= c.assignment_id %>?filter=below"><%= c.below_min %> students</a>
                <% } else { %>
                  <span class="pill g">None</span>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4">Total</td>
            <td class="num"><%= stats.totalStudents || classes.reduce((s, c) => s + c.students, 0) %></td>
            <td class="num"><%= stats.sessionsHeld %></td>
            <td colspan="2">Institutional minimum threshold: 75%</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>

  <div class="stack">
    <%- include('../partials/notices-card') %>

    <section class="card">
      <div class="hd"><h2>Needs attention</h2></div>
      <% if (stats.belowMin > 0) { %>
        <div class="item">
          <span class="dot r"></span>
          <div class="t">
            <div><%= stats.belowMin %> student<%= stats.belowMin === 1 ? '' : 's' %> below 75% attendance</div>
            <div class="s"><a href="/faculty/classes">Check class rosters to notify students</a></div>
          </div>
        </div>
      <% } else { %>
        <div class="item">
          <span class="dot g"></span>
          <div class="t">
            <div>All students on track</div>
            <div class="s">No critical attendance shortages in your classes</div>
          </div>
        </div>
      <% } %>

      <% if (pendingLeaves > 0) { %>
        <div class="item">
          <span class="dot o"></span>
          <div class="t">
            <div><%= pendingLeaves %> leave application pending approval</div>
            <div class="s"><a href="/faculty/leave">Track leave request status</a></div>
          </div>
        </div>
      <% } %>
    </section>

    <section class="card">
      <div class="hd">
        <h2><%= classDay && classDay.offset === 0 ? 'Today' : 'Next teaching day' %></h2>
        <span class="muted"><%= classDay ? fmt.day(classDay.day) : '' %></span>
      </div>
      <% if (!classDay || !classDay.rows.length) { %>
        <div class="empty">No lectures scheduled for this day.</div>
      <% } else { %>
        <% for (const t of classDay.rows) { %>
          <div class="tt-slot">
            <div class="tt-time"><b><%= fmt.time(t.start_time) %></b><%= fmt.time(t.end_time) %></div>
            <div class="t">
              <div><%= t.course_name %></div>
              <div class="s"><%= t.session_type %> · <%= t.room_code %> · Division <%= t.division_code || 'A' %></div>
            </div>
          </div>
        <% } %>
      <% } %>
    </section>
  </div>
</div>

<%- include('../partials/layout-end') %>
