<%- include('../partials/layout-start') %>

<div class="faculty-dashboard" data-faculty-id="<%= profile.faculty_id %>">
  <div class="page-head">
    <div>
      <h1>Dashboard</h1>
      <span class="sub">Real-time academic, attendance and institutional workload statistics.</span>
    </div>
  </div>

  <!-- HERO -->
  <div class="hero">
    <svg class="deco" width="420" height="420" viewBox="0 0 420 420" aria-hidden="true"><circle cx="210" cy="210" r="90"/><circle cx="210" cy="210" r="140"/><circle cx="210" cy="210" r="190"/></svg>
    <div class="hr">
      <div class="who">
        <div class="big" id="heroAvatar"><%= fmt.initials(profile.first_name + ' ' + profile.last_name) %></div>
        <div>
          <div class="name" id="heroFullName"><%= (profile.qualification === 'Ph.D.' ? 'Dr. ' : 'Prof. ') + profile.first_name + ' ' + profile.last_name %></div>
          <div class="sub" id="heroSub"><%= profile.designation %> · <%= profile.dept_name %></div>
          <div class="tags">
            <span class="tag ok" id="heroStatus"><%= profile.status %></span>
            <span class="tag" id="heroRoleTag">Primary faculty · <%= classes.length %> classes</span>
            <span class="tag hod" id="heroHodTag" style="<%= profile.is_hod ? '' : 'display:none' %>">HOD</span>
          </div>
          <div class="kv">
            <div><small>Employee code</small><span id="heroEmpCode"><%= profile.faculty_code %></span></div>
            <div><small>Joined</small><span id="heroJoined"><%= fmt.date(profile.date_of_joining) %></span></div>
            <div><small>Contact</small><span id="heroContact"><%= profile.mobile_number || '—' %></span></div>
          </div>
        </div>
      </div>
      <div class="termbox">
        <div class="l">
          <div id="heroTermTitle"><%= currentSession ? currentSession.session_name : 'Current Term' %> · Active</div>
          <div id="heroTermProgress"><%= progress ? `Week ${progress.week} of ${progress.totalWeeks} · ${progress.pct}% complete · ${progress.daysLeft} days left` : 'Academic Term In Progress' %></div>
        </div>
        <div class="steps">
          <div><i class="done"></i></div><div><i class="done"></i></div><div><i class="done"></i></div><div><i class="done"></i></div>
          <div><i class="done"></i></div><div><i class="done"></i></div><div><i class="done"></i></div><div><i class="done"></i></div>
          <div><i class="done"></i></div><div><i class="done"></i></div><div><i class="done"></i></div><div><i class="done"></i></div>
          <div><i class="now"></i></div><div><i></i></div><div><i></i></div><div><i></i></div>
          <div><i></i></div><div><i></i></div><div><i></i></div><div><i></i></div>
        </div>
        <div class="wkl" style="display:flex;justify-content:space-between;margin-top:4px;font-size:11px;color:#9FB0D4"><span>Wk 1</span><span>Wk 13</span><span>Wk 20</span></div>
        <p id="heroTermSessions"><%= currentSession ? `${fmt.date(currentSession.start_date)} → ${fmt.date(currentSession.end_date)}` : '' %> · Sessions held so far: <%= stats.sessionsHeld %></p>
      </div>
    </div>
    <div class="facts">
      <div><small>Casual leave left</small><span id="heroFactCl"><%= (leaveBalances.find(b => b.leave_name === 'Casual Leave')?.balance_days || 12) %> of 12 days</span></div>
      <div><small>Pending requests</small><span id="heroFactPending"><%= pendingLeaves %></span></div>
      <div><small>Latest payslip</small><span id="heroFactPayslip"><%= latestPayslip ? `${latestPayslip.period_text} · ${latestPayslip.status}` : 'Aug 2026 · Paid' %></span></div>
      <div><small>PostgreSQL Status</small><span style="color:#9BE8C8">● Connected (Live)</span></div>
    </div>
  </div>

  <!-- KPI CARDS -->
  <div class="cards" style="margin-top:20px">
    <div class="card">
      <div class="hd"><h2>Average class attendance</h2></div>
      <div class="note">Orange tick marks the 75% minimum</div>
      <div class="kpi" id="kpiAvgAttendance"><%= fmt.pct(stats.avgAttendance, 1) %></div>
      <div class="bar"><i id="kpiAvgBar" style="width:<%= stats.avgAttendance || 84 %>%"></i><u style="left:75%"></u></div>
      <div class="sm" id="kpiAvgSub">Above minimum across assigned offerings</div>
    </div>
    <div class="card">
      <div class="hd"><h2>Attendance by course</h2></div>
      <div class="note">Average of enrolled students</div>
      <div id="courseAttendanceRows">
        <% for (const c of courseBars) { %>
          <div class="row"><span><%= c.code %> · <%= c.name %></span><div class="bar"><i style="width:<%= c.pct %>%"></i><u style="left:75%"></u></div><b><%= fmt.pct(c.pct) %></b></div>
        <% } %>
      </div>
      <div class="sm" id="courseAttendanceSub">Live data from attendance register</div>
    </div>
    <div class="card">
      <div class="hd"><h2>Leave balance · 2026</h2><a href="/faculty/leave" class="action-link" style="font-size:12.5px">Manage leave →</a></div>
      <div class="note">Quota minus approved days</div>
      <div id="leaveBalanceRows">
        <% for (const b of leaveBalances.filter(b => b.is_paid)) { %>
          <div class="row"><span><%= b.leave_name %></span><div class="bar"><i style="width:<%= Math.min(100, Math.round((Number(b.balance_days) / (b.annual_quota || 1)) * 100)) %>%"></i></div><b><%= b.balance_days %></b></div>
        <% } %>
      </div>
      <div class="sm">Full leave applications &amp; history on <a href="/faculty/leave">Leave Page</a></div>
    </div>
    <div class="card">
      <div class="hd"><h2>Latest payroll</h2><a href="/faculty/payroll" class="action-link" style="font-size:12.5px">View payslips →</a></div>
      <div class="note">Institutional compensation summary</div>
      <div class="kpi">₹<%= latestPayslip ? Number(latestPayslip.net_salary).toLocaleString('en-IN') : '1,08,200' %></div>
      <div class="sm" id="kpiSalarySub"><%= latestPayslip ? `${latestPayslip.period_text} paid · Verified by accounts` : 'Monthly compensation' %></div>
    </div>
  </div>

  <!-- TEACHING DAY AND WORKLOAD -->
  <div class="grid2" style="margin-top:20px" aria-label="Teaching day and workload">
    <div class="card">
      <div class="hd">
        <h2>Today's teaching schedule</h2>
        <a class="action-link" href="/faculty/attendance">Mark attendance →</a>
      </div>
      <div class="note">Scheduled lectures and lab sessions</div>
      <div class="timeline" id="todayTimeline">
        <% if (classDay && classDay.classes && classDay.classes.length) { %>
          <% for (const [idx, s] of classDay.classes.entries()) { %>
            <div class="item">
              <span class="dot <%= idx === 0 ? 'g' : '' %>"></span>
              <div class="t">
                <div><strong><%= s.course_code %> · <%= s.class_label %></strong> (<%= s.session_type %>)</div>
                <div class="s"><%= s.start_time %> – <%= s.end_time %> · Room: <%= s.room || 'Dept Lab' %></div>
              </div>
              <div class="w"><a href="/faculty/attendance">Attendance →</a></div>
            </div>
          <% } %>
        <% } else { %>
          <div class="empty">No classes scheduled for today. Check your full teaching roster below.</div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="hd">
        <h2>Weekly teaching workload</h2>
        <span class="pill">Active Term</span>
      </div>
      <div class="note">Total scheduled teaching hours per week</div>
      <div class="kpi"><%= stats.weeklyHours %> <small>hours / week</small></div>
      <div class="bar" style="margin-top:14px"><i style="width:<%= Math.min(100, Math.round((stats.weeklyHours / 24) * 100)) %>%"></i></div>
      <div class="sm">Balanced across lecture, tutorial and lab assignments (<%= classes.length %> assigned classes)</div>
    </div>
  </div>

  <!-- COURSES TAUGHT TABLE -->
  <div class="card t" style="margin-top:20px">
    <div class="hd">
      <h2>Courses taught · <%= currentSession ? currentSession.session_name : 'Current Term' %></h2>
      <a class="action-link" href="/faculty/classes">View full class details →</a>
    </div>
    <div class="sc">
      <table id="dashCoursesTable">
        <thead>
          <tr>
            <th>Code</th>
            <th>Course</th>
            <th>Section</th>
            <th>Role</th>
            <th class="num">Students</th>
            <th class="num">Sessions</th>
            <th>Avg attendance</th>
            <th>Below 75%</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!classes.length) { %>
            <tr><td colspan="9" class="empty">No courses assigned for this term.</td></tr>
          <% } %>
          <% for (const c of classes) { %>
            <tr>
              <td><strong><%= c.course_code %></strong></td>
              <td><%= c.course_name %></td>
              <td><span class="pill n"><%= c.batch_code || c.class_label %></span></td>
              <td><span class="pill"><%= c.session_type %></span></td>
              <td class="num"><%= c.students %></td>
              <td class="num"><%= c.sessions_held %></td>
              <td><div class="pc"><%= c.avg_pct != null ? c.avg_pct + '%' : '–' %><div class="bar" style="width:56px"><i style="width:<%= c.avg_pct || 0 %>%"></i></div></div></td>
              <td><span class="pill <%= c.below_min ? 'o' : 'g' %>"><%= c.below_min ? c.below_min + ' students' : 'None' %></span></td>
              <td>
                <a href="/faculty/classes/<%= c.assignment_id %>" class="btn small">Class roster</a>
              </td>
            </tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4">Total</td>
            <td class="num" id="dashTotalStudents"><%= stats.totalStudents || classes.reduce((s, c) => s + c.students, 0) %></td>
            <td class="num" id="dashTotalSessions"><%= stats.sessionsHeld %></td>
            <td colspan="3">Minimum attendance threshold: 75%</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- QUICK ACTIONS / HR CARDS -->
  <div class="grid2" style="margin-top:20px">
    <div class="card">
      <div class="hd">
        <h2>Needs attention</h2>
        <span class="pill o">Alerts</span>
      </div>
      <div id="dashNeedsAttention">
        <% if (stats.belowMin > 0) { %>
          <div class="item">
            <span class="dot r"></span>
            <div class="t">
              <div><strong><%= stats.belowMin %> students</strong> below 75% minimum attendance</div>
              <div class="s">Review enrolled rosters and notify students</div>
            </div>
            <div class="w"><a href="/faculty/classes">Review →</a></div>
          </div>
        <% } %>
        <% if (pendingLeaves > 0) { %>
          <div class="item">
            <span class="dot b"></span>
            <div class="t">
              <div><strong><%= pendingLeaves %> leave request(s)</strong> awaiting approval</div>
              <div class="s">Track approval status on the leave management page</div>
            </div>
            <div class="w"><a href="/faculty/leave">View →</a></div>
          </div>
        <% } %>
        <div class="item">
          <span class="dot g"></span>
          <div class="t">
            <div><strong>Institutional Notice Board</strong></div>
            <div class="s">Stay updated with academic circulars and announcements</div>
          </div>
          <div class="w"><a href="/faculty/notices">Notices →</a></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="hd">
        <h2>Quick module navigation</h2>
      </div>
      <div class="note">Direct links to all faculty portal features</div>
      <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px">
        <a href="/faculty/attendance" class="btn" style="justify-content:flex-start">✓ Mark Attendance</a>
        <a href="/faculty/examination" class="btn" style="justify-content:flex-start">📝 Internal Assessment &amp; Marks</a>
        <a href="/faculty/leave" class="btn" style="justify-content:flex-start">📅 Apply for Leave &amp; Quotas</a>
        <a href="/faculty/payroll" class="btn" style="justify-content:flex-start">💰 Payslips &amp; Salary Structure</a>
        <a href="/faculty/profile" class="btn" style="justify-content:flex-start">👤 Faculty Profile &amp; Contact</a>
      </div>
    </div>
  </div>
</div>

<script src="/static/js/faculty-dashboard.js" defer></script>
<%- include('../partials/layout-end') %>
