<%- include('../partials/layout-start') %>
<div class="page-head"><h1>My classes</h1><span class="sub"><%= currentSession.session_name %> · <%= classes.length %> teaching assignments</span></div>
<section class="card t">
  <div class="sc"><table>
    <thead><tr><th>Code</th><th>Course</th><th>Class</th><th>Type</th><th class="num">Per week</th><th class="num">Students</th><th class="num">Held</th><th>Last session</th><th>Avg attendance</th><th>Below min</th></tr></thead>
    <tbody>
      <% if (!classes.length) { %><tr><td colspan="10" class="empty">No classes assigned this term.</td></tr><% } %>
      <% for (const c of classes) { %>
        <tr>
          <td class="code"><%= c.course_code %></td>
          <td><a href="/faculty/classes/<%= c.assignment_id %>"><%= c.course_name %></a></td>
          <td class="nw"><%= c.batch_code || c.class_label %></td>
          <td><span class="pill<%= c.session_type === 'Lab' ? ' g' : '' %>"><%= c.session_type %></span></td>
          <td class="num"><%= c.weekly_sessions %></td>
          <td class="num"><%= c.students %></td>
          <td class="num"><%= c.sessions_held %></td>
          <td class="nw"><%= fmt.shortDate(c.last_session) %></td>
          <td><%- include('../partials/pct-bar', { value: c.avg_pct, min: c.min_attendance_pct }) %></td>
          <td><% if (c.below_min) { %><a class="pill o" href="/faculty/classes/<%= c.assignment_id %>?filter=below"><%= c.below_min %></a><% } else { %><span class="pill g">None</span><% } %></td>
        </tr>
      <% } %>
    </tbody>
  </table></div>
</section>
<%- include('../partials/layout-end') %>
