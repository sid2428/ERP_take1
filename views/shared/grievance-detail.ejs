<%- include('../partials/layout-start') %>
<div class="page-head"><h1>#<%= g.grievance_id %> · <%= g.subject %></h1><span class="sub"><a href="<%= base %>">← Grievances</a></span></div>
<% const closed = g.status === 'Resolved' || g.status === 'Rejected'; %>
<div class="grid2">
<div class="stack" style="gap:0">
  <section class="card" style="margin-bottom:16px">
    <div class="hd"><h2>Details</h2><span class="pill <%= statusPill(g.status) %>"><%= g.status %></span></div>
    <dl class="dl" style="margin-bottom:14px">
      <div><dt>Category</dt><dd><%= g.category %></dd></div>
      <% if (g.course_id) { %><div><dt>Course</dt><dd><%= g.course_code %> · <%= g.course_name %></dd></div><% } %>
      <div><dt>Raised by</dt><dd><%= g.raised_by_name %> (<%= g.raised_by_login %>)</dd></div>
      <div><dt>Raised on</dt><dd><%= fmt.dateTime(g.created_at) %></dd></div>
      <div><dt>Handled by</dt><dd><%= g.assigned_name ? g.assigned_name : 'Academic office' %><%= g.course_id ? ' (course teacher)' : '' %></dd></div>
    </dl>
    <div class="thread"><div class="body"><%= g.description %></div></div>
  </section>
  <%- include('../partials/grievance-thread') %>
</div>

<div class="stack">
<% if (isHandler && !closed) { %>
  <section class="card">
    <div class="hd"><h2>Decision</h2></div>
    <form method="post" action="<%= base %>/<%= g.grievance_id %>/resolve" class="stack" style="gap:10px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="rn">Note to <%= g.raised_by_name %></label>
        <textarea id="rn" name="note" rows="4" minlength="5" maxlength="2000" required placeholder="What was done, or why it is rejected"></textarea>
      </div>
      <div class="actions">
        <button class="btn primary" type="submit" name="outcome" value="Resolved">Resolve</button>
        <button class="btn danger" type="submit" name="outcome" value="Rejected">Reject</button>
      </div>
      <p class="note" style="margin:0">Either choice locks the grievance. Only the academic office can unlock it again.</p>
    </form>
    <% if (g.status === 'Open') { %>
    <form method="post" action="<%= base %>/<%= g.grievance_id %>/progress" style="margin-top:12px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit">Mark In progress</button>
      <span class="note">Tells the student you are looking into it.</span>
    </form>
    <% } %>
  </section>
<% } %>
<% if (closed) { %>
  <section class="card">
    <div class="hd"><h2>Locked</h2><span class="pill <%= statusPill(g.status) %>"><%= g.status %></span></div>
    <p class="muted" style="margin:0">Closed on <%= fmt.dateTime(g.resolved_at) %>. No more replies can be added.
      <% if (isRaiser) { %>If you disagree with the outcome, contact the academic office: they can unlock it.<% } else { %>Only the academic office can unlock it.<% } %></p>
  </section>
<% } %>
<section class="card">
  <div class="hd"><h2>Progress</h2></div>
  <% const steps = ['Open', 'In progress', g.status === 'Rejected' ? 'Rejected' : 'Resolved'];
     const at = steps.indexOf(g.status); %>
  <% steps.forEach((s, i) => { %>
  <div class="item"><div class="t"><div><span class="pill <%= i <= at ? statusPill(s) : 'n' %>"><%= s %></span></div>
    <div class="s"><%= i < at ? 'Done' : i === at ? (closed ? 'Current · locked' : 'Current') : 'Pending' %></div></div></div>
  <% }) %>
  <p class="note" style="margin-top:12px">
    <% if (g.resolved_at) { %>Closed after <%= g.age_days %> days.<% } else { %>Open for <%= g.age_days %> days.<% } %>
  </p>
</section>
</div>
</div>
<%- include('../partials/layout-end') %>
