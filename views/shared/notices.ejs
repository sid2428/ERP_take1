<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Notices</h1><span class="sub">Announcements from the academic office<%= isFaculty ? ' and your department' : ' and your teachers' %></span></div>

<% if (isFaculty) { %>
<section class="card t" style="margin-bottom:16px">
  <div class="hd"><h2>Posted by me</h2><a class="btn primary small" href="<%= base %>/new">Post a notice</a></div>
  <div class="sc"><table>
    <thead><tr><th>Notice</th><th>Audience</th><th>Posted</th><th class="num">Read</th><th>Status</th></tr></thead>
    <tbody>
      <% if (!mine.length) { %><tr><td colspan="5" class="empty">You have not posted any notices. You can post to the divisions you teach.</td></tr><% } %>
      <% for (const m of mine) { %>
      <tr>
        <td><a href="<%= base %>/<%= m.notice_id %>"><%= m.title %></a></td>
        <td><%= m.audience %></td>
        <td class="nw"><%= fmt.date(m.posted_at) %></td>
        <td class="num nw"><%= m.reach ? `${fmt.num(m.reach.reads)} / ${fmt.num(m.reach.recipients)}` : '–' %></td>
        <td><% if (m.withdrawn_at) { %><span class="pill r">Withdrawn</span><% } else if (m.expires_at && new Date(m.expires_at) < new Date()) { %><span class="pill n">Expired</span><% } else { %><span class="pill g">Live</span><% } %></td>
      </tr>
      <% } %>
    </tbody>
  </table></div>
</section>
<% } %>

<section class="card">
  <div class="hd">
    <h2>Notice board</h2>
    <% if (unread) { %>
    <form method="post" action="<%= base %>/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small" type="submit">Mark all read (<%= unread %>)</button></form>
    <% } %>
  </div>
  <div class="chips" style="margin:4px 0 8px">
    <a class="chip-link<%= category === '' ? ' on' : '' %>" href="<%= base %>">All</a>
    <% for (const c of categories) { %><a class="chip-link<%= category === c ? ' on' : '' %>" href="<%= base %>?category=<%= c %>"><%= c %></a><% } %>
  </div>
  <% if (!notices.length) { %><p class="empty">No notices<%= category ? ' in ' + category : '' %> right now.</p><% } %>
  <% for (const n of notices) { %>
  <div class="notice<%= n.is_read ? '' : ' unread' %>">
    <div class="title">
      <% if (n.is_important) { %><span class="pill r">Important</span> <% } %>
      <a href="<%= base %>/<%= n.notice_id %>"><%= n.title %></a>
      <% if (!n.is_read) { %><span class="dot b inline" title="Unread"></span><% } %>
    </div>
    <div class="meta"><span class="pill <%= categoryPill(n.category) %>"><%= n.category %></span> · <%= n.posted_by_name %> · <%= fmt.dateTime(n.posted_at) %></div>
  </div>
  <% } %>
</section>
<%- include('../partials/layout-end') %>
