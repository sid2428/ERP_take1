<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Placement companies</h1><span class="sub">Companies with historical drives are deactivated, never deleted.</span></div>
<form class="card form-grid" method="post" action="/admin/placement/companies"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Company name<input name="company_name" required maxlength="140"></label><label>Industry<input name="industry" maxlength="80"></label><label>Website<input name="website_url" type="url"></label><label>Contact name<input name="contact_name" maxlength="100"></label><label>Contact email<input name="contact_email" type="email"></label><label>Contact phone<input name="contact_phone" maxlength="30"></label><label>Headquarters<input name="headquarters" maxlength="100"></label><label class="wide">Description<textarea name="description" maxlength="3000"></textarea></label><div class="wide"><button class="btn">Add company</button></div></form>
<section class="card"><h2>Companies</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Industry</th><th>Drives</th><th>Status</th><th></th></tr></thead><tbody><% companies.forEach(c=>{ %><tr><td><%= c.company_name %></td><td><%= c.industry||'—' %></td><td><%= c.drive_count %></td><td><%= c.is_active?'Active':'Inactive' %></td><td><div class="actions"><a class="btn secondary" href="/admin/placement/companies/<%= c.company_id %>">Edit</a><form method="post" action="/admin/placement/companies/<%= c.company_id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary"><%= c.is_active?'Deactivate':'Activate' %></button></form></div></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/layout-end') %>
