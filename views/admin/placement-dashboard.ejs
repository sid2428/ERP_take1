<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Training &amp; Placement</h1><span class="sub">Management is available to Admin accounts in this version.</span></div>
<div class="cards"><div class="card"><div class="s">Active students</div><div class="kpi"><%= overview?.active_students ?? 0 %></div></div><div class="card"><div class="s">Placed students</div><div class="kpi"><%= overview?.placed_students ?? 0 %></div></div><div class="card"><div class="s">Accepted full-time offers</div><div class="kpi"><%= overview?.accepted_fulltime_offers ?? 0 %></div></div><div class="card"><div class="s">Highest accepted package</div><div class="kpi"><%= overview?.highest_package_lpa ?? '—' %><small> LPA</small></div></div></div>
<div class="actions"><a class="btn" href="/admin/placement/companies">Manage companies</a><a class="btn" href="/admin/placement/drives/new">Create drive</a><a class="btn secondary" href="/admin/placement/statistics">Statistics</a></div>
<section class="card"><h2>Recent drives</h2><% if (!drives.length) { %><p class="empty">No drives created yet.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Drive</th><th>Company</th><th>Status</th><th>Deadline</th><th>Applicants</th></tr></thead><tbody><% drives.forEach(d=>{ %><tr><td><a href="/admin/placement/drives/<%= d.drive_id %>"><%= d.title %></a></td><td><%= d.company_name %></td><td><%= d.status %></td><td><%= new Date(d.deadline).toLocaleDateString() %></td><td><%= d.applicants %></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include('../partials/layout-end') %>
