<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Faculty</h1><span class="sub"><%= fmt.num(pager.total) %> matching records</span></div>
<form class="filters" method="get" action="/admin/faculty">
  <label class="sr-only" for="q">Search</label>
  <input id="q" type="search" name="q" value="<%= filters.q %>" placeholder="Name or faculty code">
  <select name="dept" data-autosubmit aria-label="Department"><option value="">All departments</option>
    <% for (const d of depts) { %><option<%= filters.dept === d ? ' selected' : '' %>><%= d %></option><% } %></select>
  <button class="btn" type="submit">Search</button>
  <% if (filters.q || filters.dept) { %><a class="btn link" href="/admin/faculty">Clear</a><% } %>
</form>
<section class="card t">
  <div class="sc"><table>
    <thead><tr><th>Code</th><th>Name</th><th>Dept</th><th>Designation</th><th class="num">Load (h/week)</th><th>Status</th></tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="6" class="empty">No faculty match.</td></tr><% } %>
      <% for (const f of rows) { %>
        <tr class="click"><td class="code"><%= f.faculty_code %></td><td><a href="/admin/faculty/<%= f.faculty_id %>"><%= f.name %></a><% if (f.is_hod) { %> <span class="pill">HOD</span><% } %></td>
          <td><%= f.dept_id %></td><td><%= f.designation %></td><td class="num"><%= f.weekly_hours %></td>
          <td><span class="pill <%= f.status === 'Active' ? 'g' : 'n' %>"><%= f.status %></span></td></tr>
      <% } %>
    </tbody>
  </table></div>
  <%- include('../partials/pager') %>
</section>
<%- include('../partials/layout-end') %>
