<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Edit company</h1><span class="sub">Company records with history cannot be deleted.</span></div>
<form class="card form-grid" method="post" action="/admin/placement/companies/<%= company.company_id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Company name<input name="company_name" required maxlength="140" value="<%= company.company_name %>"></label><label>Industry<input name="industry" maxlength="80" value="<%= company.industry||'' %>"></label><label>Website<input name="website_url" type="url" value="<%= company.website_url||'' %>"></label><label>Contact name<input name="contact_name" maxlength="100" value="<%= company.contact_name||'' %>"></label><label>Contact email<input name="contact_email" type="email" value="<%= company.contact_email||'' %>"></label><label>Contact phone<input name="contact_phone" maxlength="30" value="<%= company.contact_phone||'' %>"></label><label>Headquarters<input name="headquarters" maxlength="100" value="<%= company.headquarters||'' %>"></label><label class="wide">Description<textarea name="description" maxlength="3000"><%= company.description||'' %></textarea></label><div class="wide"><button class="btn">Save company</button></div></form>
<%- include('../partials/layout-end') %>
