<%- include('../partials/layout-start') %>
<% const p = program; %>
<div class="crumbs"><a href="/admin/programs">Programs</a> / <%= p.program_id %></div>
<div class="page-head">
  <h1><%= p.program_name %></h1>
  <span class="sub"><%= p.program_id %> · <%= p.dept_name %> · <%= p.degree_level %> · <%= p.total_semesters %> semesters</span>
</div>

<% if (creditDifference !== 0) { %>
  <div class="flash error" role="alert">
    <strong>Credit requirement mismatch:</strong> Placed courses total <strong><%= fmt.credits(totalPlacedCredits) %></strong> credits, but the program requires <strong><%= fmt.credits(totalCreditsReq) %></strong> credits. Difference: <strong><%= creditDifference > 0 ? '+' : '' %><%= fmt.credits(creditDifference) %> credits</strong> (<%= creditDifference < 0 ? fmt.credits(Math.abs(creditDifference)) + ' credits short' : fmt.credits(creditDifference) + ' credits in excess' %>).
  </div>
<% } %>

<section class="card">
  <div class="hd">
    <h2>Semester map</h2>
    <span class="muted">Placed: <%= fmt.credits(totalPlacedCredits) %> / <%= fmt.credits(totalCreditsReq) %> credits · Remove placement with ×</span>
  </div>
  <div class="sem-grid" style="margin-top:12px">
    <% for (const s of semesters) { %>
      <div class="sem-box">
        <div class="hd">
          <span>Semester <%= fmt.roman(s.no) %></span>
          <span class="pill n" style="font-size:11px"><%= fmt.credits(s.credits) %> cr</span>
        </div>
        <ul>
          <% if (!s.courses.length) { %><li class="cn">No courses placed</li><% } %>
          <% for (const c of s.courses) { %>
            <li><span class="cc"><a href="/admin/courses/<%= c.course_id %>"><%= c.course_code %></a>
              <% if (c.elective_group) { %><span class="pill <%= c.elective_group === 'H1' ? 'v' : c.course_category === 'OPEN_ELECTIVE' ? 't' : 'o' %>" style="font-size:10px"><%= c.elective_group %></span><% } %>
              <form class="inline" method="post" action="/admin/programs/<%= p.program_id %>/curriculum/<%= c.course_id %>/delete" data-confirm="Remove <%= c.course_code %> from semester <%= s.no %>?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn link" type="submit" title="Remove" aria-label="Remove <%= c.course_code %>">×</button></form></span>
              <span class="cn"><%= c.course_name %> · <%= fmt.credits(c.credits) %> cr</span></li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </div>
</section>

<section class="card">
  <div class="hd">
    <h2>Prerequisite graph</h2>
    <span class="muted">Course dependency flow by semester (arrows indicate prerequisite → course)</span>
  </div>
  <% if (!graph.nodes.length) { %>
    <div class="empty">No courses placed in this program yet.</div>
  <% } else { %>
    <div class="sc" style="margin-top:12px; padding-bottom:8px">
      <svg width="<%= graph.width %>" height="<%= graph.height %>" viewBox="0 0 <%= graph.width %> <%= graph.height %>" style="display:block; min-width:<%= graph.width %>px; font-family:inherit;">
        <defs>
          <marker id="prereq-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="#1F4FA3" />
          </marker>
        </defs>
        <!-- Column headers & vertical divider guides -->
        <% for (const col of graph.columns) { %>
          <text x="<%= col.x + col.width / 2 %>" y="24" text-anchor="middle" font-size="12" font-weight="600" fill="#5B6578">Semester <%= fmt.roman(col.semester) %></text>
          <line x1="<%= col.x + col.width + 25 %>" y1="12" x2="<%= col.x + col.width + 25 %>" y2="<%= graph.height - 12 %>" stroke="#EEF0F5" stroke-dasharray="4" />
        <% } %>
        <!-- Prerequisite dependency edges -->
        <% for (const e of graph.edges) { %>
          <path d="<%= e.d %>" fill="none" stroke="#8FB8FF" stroke-width="2" marker-end="url(#prereq-arrow)">
            <title><%= e.fromCode %> → <%= e.toCode %> (Min grade: <%= e.minGrade %>)</title>
          </path>
        <% } %>
        <!-- Course nodes -->
        <% for (const n of graph.nodes) { %>
          <g transform="translate(<%= n.x %>, <%= n.y %>)">
            <a href="/admin/courses/<%= n.courseId %>">
              <rect width="<%= n.width %>" height="<%= n.height %>" rx="6" fill="#fff" stroke="#DDE2EA" stroke-width="1.5">
                <title><%= n.code %> · <%= n.name %> (<%= fmt.credits(n.credits) %> credits)</title>
              </rect>
              <text x="10" y="20" font-size="12" font-weight="600" fill="#1F3A6E"><%= n.code %></text>
              <text x="<%= n.width - 10 %>" y="20" text-anchor="end" font-size="11" fill="#5B6578"><%= fmt.credits(n.credits) %> cr</text>
              <text x="10" y="36" font-size="10" fill="#7A8497"><%= n.name.length > 17 ? n.name.slice(0, 16) + '…' : n.name %></text>
            </a>
          </g>
        <% } %>
      </svg>
    </div>
    <% if (!graph.edges.length) { %>
      <div class="sm muted" style="margin-top:6px">No prerequisite dependencies between the placed courses of this program.</div>
    <% } %>
  <% } %>
</section>

<div class="grid2">
  <section class="card">
    <div class="hd"><h2>Place a course</h2></div>
    <form method="post" action="/admin/programs/<%= p.program_id %>/curriculum" class="stack" style="margin-top:8px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="field" style="grid-column:1/-1"><label for="cid">Course</label>
          <select id="cid" name="course_id" required><option value="">Choose a course…</option>
            <% for (const c of courses) { %><option value="<%= c.course_id %>"><%= c.course_code %> · <%= c.course_name %></option><% } %></select></div>
        <div class="field"><label for="sem">Semester</label><input id="sem" type="number" name="semester_no" min="1" max="12" value="1" required></div>
        <div class="field"><label for="cat">Category</label>
          <select id="cat" name="course_category"><option value="CORE">Core</option><option value="PROF_ELECTIVE">Professional elective</option><option value="OPEN_ELECTIVE">Open elective</option></select></div>
        <div class="field"><label for="eg">Elective basket</label><input id="eg" type="text" name="elective_group" maxlength="4" placeholder="E1, H1, O1 — blank for core"></div>
      </div>
      <div class="actions"><button class="btn primary" type="submit">Add to curriculum</button></div>
    </form>
  </section>
  <section class="card">
    <div class="hd"><h2>Program settings</h2></div>
    <form method="post" action="/admin/programs/<%= p.program_id %>" class="stack" style="margin-top:8px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="pn">Name</label><input id="pn" type="text" name="program_name" value="<%= p.program_name %>" required></div>
      <div class="form-grid">
        <div class="field"><label for="cr">Credits to graduate</label><input id="cr" type="number" step="0.5" name="total_credits_req" value="<%= p.total_credits_req %>" required></div>
        <div class="field"><label for="in">Intake capacity</label><input id="in" type="number" name="intake_capacity" value="<%= p.intake_capacity %>" required></div>
      </div>
      <label class="check"><input type="checkbox" name="is_active"<%= p.is_active ? ' checked' : '' %>> Program is active</label>
      <div class="actions"><button class="btn primary" type="submit">Save</button></div>
    </form>
  </section>
</div>
<%- include('../partials/layout-end') %>
