<%- include('../partials/layout-start') %>
<% if(drive.status==='Draft'&&!applicants.length){ %><p><a class="btn secondary" href="/admin/placement/drives/<%= drive.drive_id %>/edit">Edit drive</a></p><% } %>
<div class="page-head"><h1><%= drive.title %></h1><span class="sub"><%= drive.company_name %> · <%= drive.role_title %></span></div>
<section class="card"><p><%= drive.drive_type %> · <%= drive.status %> · deadline <%= new Date(drive.deadline).toLocaleString() %></p><a class="btn secondary" href="/admin/placement/drives/<%= drive.drive_id %>/applicants.csv">Download applicants CSV</a>
<% const nextDriveStatuses=drive.status==='Draft'?['Open','Cancelled']:drive.status==='Open'?['Closed','Cancelled']:[]; if(nextDriveStatuses.length){ %><form class="actions" method="post" action="/admin/placement/drives/<%= drive.drive_id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% nextDriveStatuses.forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><button class="btn secondary">Update status</button></form><% } %></section>
<section class="card"><h2>Rounds</h2><% rounds.forEach(r=>{ %><p><%= r.sequence_no %>. <%= r.round_name %> — <%= r.status %> <%= r.scheduled_at?`(${new Date(r.scheduled_at).toLocaleString()})`:'' %></p><% }) %><form class="form-grid" method="post" action="/admin/placement/drives/<%= drive.drive_id %>/rounds"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Sequence<input type="number" name="sequence_no" min="1" required></label><label>Round name<input name="round_name" required></label><label>Description<input name="description"></label><label>Date/time<input type="datetime-local" name="scheduled_at"></label><div class="wide"><button class="btn">Add round</button></div></form></section>
<section class="card"><h2>Manage round schedules and status</h2><% rounds.forEach(r=>{ %><article class="card"><h3><%= r.sequence_no %>. <%= r.round_name %> - <%= r.status %></h3><% if(['Planned','InProgress'].includes(r.status)){ %><form class="form-grid" method="post" action="/admin/placement/drives/<%= drive.drive_id %>/rounds/<%= r.round_id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Round name<input name="round_name" value="<%= r.round_name %>" required maxlength="100"></label><label>Description<input name="description" value="<%= r.description||'' %>" maxlength="1000"></label><label>Schedule<input type="datetime-local" name="scheduled_at" value="<%= r.scheduled_local %>"></label><div><button class="btn secondary">Save schedule</button></div></form><form class="actions" method="post" action="/admin/placement/drives/<%= drive.drive_id %>/rounds/<%= r.round_id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% (r.status==='Planned'?['InProgress','Cancelled']:['Completed','Cancelled']).forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><button class="btn secondary">Update status</button></form><% } %></article><% }) %></section><section class="card"><h2>Applicants (<%= applicants.length %>)</h2><% if(!applicants.length){ %><div class="empty">No applications yet.</div><% } %><% applicants.forEach(a=>{ %><article class="card"><h3><%= a.student_number %> · <%= a.first_name %> <%= a.last_name %></h3><p><%= a.program_name %> · Year <%= a.year_of_study||'unknown' %> · <%= a.status %></p>
<% if(a.next_statuses.length){ %><form class="actions" method="post" action="/admin/placement/applications/<%= a.application_id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% a.next_statuses.forEach(s=>{ %><option value="<%= s %>"><%= s %></option><% }) %></select><button class="btn secondary">Update stage</button></form><% } %>
<form class="form-grid" method="post" action="/admin/placement/applications/<%= a.application_id %>/results"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Round<select name="round_id"><% rounds.forEach(r=>{ %><option value="<%= r.round_id %>"><%= r.sequence_no %>. <%= r.round_name %></option><% }) %></select></label><label>Result<select name="result"><option>Pending</option><option>Passed</option><option>Failed</option><option>OnHold</option></select></label><label>Private remarks<input name="private_remarks" maxlength="1000"></label><div><button class="btn secondary">Save result</button></div></form>
<% if(a.status==='Selected'&&!a.offer_id){ %><form class="form-grid" method="post" action="/admin/placement/applications/<%= a.application_id %>/offers"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Full-time package LPA<input type="number" name="package_lpa" step="0.01" min="0"></label><label>Internship monthly stipend<input type="number" name="stipend_monthly" step="0.01" min="0"></label><label>Response deadline<input type="datetime-local" name="response_deadline" required></label><label>Joining date<input type="date" name="joining_date"></label><div><button class="btn">Record offer</button></div></form><% } else if(a.offer_id) { %><p>Offer <%= a.offer_status %> · <%= a.package_lpa!=null?`${a.package_lpa} LPA`:`₹${fmt.num(a.stipend_monthly)} monthly` %></p><% } %></article><% }) %></section>
<%- include('../partials/layout-end') %>
