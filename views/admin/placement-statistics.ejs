<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Placement statistics</h1><span class="sub">Placed means an active student with an accepted full-time offer. Internships are reported separately.</span></div>
<div class="cards"><div class="card"><div class="s">Accepted full-time offer count</div><div class="kpi"><%= overview?.accepted_fulltime_offers??0 %></div></div><div class="card"><div class="s">Accepted internships</div><div class="kpi"><%= overview?.accepted_internships??0 %></div></div><div class="card"><div class="s">Average package (LPA)</div><div class="kpi"><%= overview?.average_package_lpa?fmt.num(overview.average_package_lpa):'—' %></div></div><div class="card"><div class="s">Median package (LPA)</div><div class="kpi"><%= overview?.median_package_lpa?fmt.num(overview.median_package_lpa):'—' %></div></div></div>
<section class="card"><h2>By department</h2><div class="table-wrap"><table><thead><tr><th>Department</th><th>Active students</th><th>Placed</th><th>Placed %</th><th>Highest LPA</th></tr></thead><tbody><% byDepartment.forEach(d=>{ %><tr><td><%= d.dept_name %></td><td><%= d.active_students %></td><td><%= d.placed_students %></td><td><%= d.placed_pct??'—' %></td><td><%= d.highest_package_lpa??'—' %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/layout-end') %>
