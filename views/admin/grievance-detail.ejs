<%- include('../partials/layout-start') %>
<% const closed = g.status === 'Resolved' || g.status === 'Rejected'; %>
<div class="page-head"><h1>#<%= g.grievance_id %> · <%= g.subject %></h1><span class="sub"><a href="<%= back %>">← <%= g.course_id ? 'Grievances of ' + g.assigned_name : 'General queue' %></a></span></div>
<div class="grid2">
<div class="stack" style="gap:0">
  <section class="card" style="margin-bottom:16px">
    <div class="hd"><h2>Details</h2><span class="pill <%= statusPill(g.status) %>"><%= g.status %></span></div>
    <dl class="dl" style="margin-bottom:14px">
      <div><dt>Category</dt><dd><%= g.category %></dd></div>
      <% if (g.course_id) { %><div><dt>Course</dt><dd><%= g.course_code %> · <%= g.course_name %></dd></div><% } %>
      <div><dt>Raised by</dt><dd><%= g.raised_by_name %>
        <div class="muted" style="font-size:12.5px"><%= g.raised_by_login %> · <%= g.raised_by_role %><%= g.raised_by_dept ? ' · ' + g.raised_by_dept : '' %></div></dd></div>
      <div><dt>Raised on</dt><dd><%= fmt.dateTime(g.created_at) %></dd></div>
      <div><dt><%= g.course_id ? 'Teacher' : 'Assigned to' %></dt><dd><%= g.assigned_name ? g.assigned_name + ' (' + g.assigned_code + ')' : '–' %></dd></div>
    </dl>
    <div class="thread"><div class="body"><%= g.description %></div></div>
  </section>
  <%- include('../partials/grievance-thread') %>
</div>

<div class="stack">
<% if (closed) { %>
  <section class="card">
    <div class="hd"><h2>Locked</h2><span class="pill <%= statusPill(g.status) %>"><%= g.status %></span></div>
    <p class="muted">Closed on <%= fmt.dateTime(g.resolved_at) %>, <%= g.age_days %> days after it was raised<%= g.course_id ? ', by the teacher' : '' %>.
      Unlocking sends it back to In progress<%= g.assigned_name ? ' with ' + g.assigned_name : '' %> so the conversation can continue.</p>
    <form method="post" action="/admin/grievances/<%= g.grievance_id %>/unlock" class="stack" style="gap:10px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="ur">Reason for unlocking</label>
        <textarea id="ur" name="reason" rows="3" minlength="5" maxlength="2000" required placeholder="e.g. The student says the marks are still not corrected"></textarea>
        <span class="hint">The student<%= g.assigned_name ? ' and the teacher' : '' %> will see this reason.</span>
      </div>
      <div class="actions"><button class="btn primary" type="submit">Unlock grievance</button></div>
    </form>
  </section>
<% } else if (g.course_id) { %>
  <section class="card">
    <div class="hd"><h2>With the teacher</h2></div>
    <p class="muted"><%= g.assigned_name %> teaches <%= g.raised_by_name %> this course and handles this grievance. They resolve or reject it, which locks it; you can unlock it afterwards.</p>
  </section>

  <section class="card">
    <div class="hd"><h2>Reassign</h2></div>
    <p class="note">Only if <%= g.assigned_name %> cannot handle it, for example while on leave. Student-related faculty are recommended first.</p>
    <%- include('../partials/admin-faculty-assignment', { formAction: '/admin/grievances/' + g.grievance_id + '/assign', submitLabel: 'Reassign', allowEmpty: false, showFallbackSearch: false, selectedCode: g.assigned_code || '', hint: 'Choose a current course faculty member. Existing course rules only permit assignment to a teacher of this student and course.' }) %>
  </section>
<% } else { %>
  <section class="card">
    <div class="hd"><h2>Decision</h2></div>
    <form method="post" action="/admin/grievances/<%= g.grievance_id %>/resolve" class="stack" style="gap:10px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="rn">Note to <%= g.raised_by_name %></label>
        <textarea id="rn" name="note" rows="4" minlength="5" maxlength="2000" required placeholder="What was done, or why it is rejected"></textarea>
      </div>
      <div class="actions">
        <button class="btn primary" type="submit" name="outcome" value="Resolved">Resolve</button>
        <button class="btn danger" type="submit" name="outcome" value="Rejected">Reject</button>
      </div>
      <p class="note" style="margin:0">Either choice closes and locks the grievance; you can unlock it later if needed.</p>
    </form>
  </section>

  <section class="card">
    <div class="hd"><h2>Assign</h2></div>
    <p class="note">The assigned faculty member can see this grievance and reply. Assigning also moves it to In progress.</p>
    <%- include('../partials/admin-faculty-assignment', { formAction: '/admin/grievances/' + g.grievance_id + '/assign', submitLabel: g.assigned_code ? 'Change assignment' : 'Assign', allowEmpty: true, showFallbackSearch: true, selectedCode: g.assigned_code || '', hint: 'Recommended faculty are connected to the student. Leave empty to remove the assignment.' }) %>
  </section>

  <% if (g.status === 'Open') { %>
  <section class="card">
    <div class="hd"><h2>Pick it up</h2></div>
    <p class="note">Handle it in the office without assigning anyone.</p>
    <form method="post" action="/admin/grievances/<%= g.grievance_id %>/progress">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit">Mark In progress</button>
    </form>
  </section>
  <% } %>
<% } %>
</div>
</div>
<%- include('../partials/layout-end') %>
