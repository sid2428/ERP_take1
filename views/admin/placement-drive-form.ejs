<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Create placement drive</h1><span class="sub">CGPA and backlog checks fail closed because this repository has no academic-standing source yet.</span></div>
<% if(errors?.length){ %><div class="flash error"><ul><% errors.forEach(e=>{ %><li><%= e %></li><% }) %></ul></div><% } %>
<form class="card form-grid" method="post" action="/admin/placement/drives"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Company<select name="company_id" required><option value="">Choose company</option><% companies.forEach(c=>{ %><option value="<%= c.company_id %>" <%= form.company_id==c.company_id?'selected':'' %>><%= c.company_name %></option><% }) %></select></label>
<label>Drive type<select name="drive_type"><option value="FullTime">Full-time</option><option value="Internship">Internship</option></select></label>
<label>Drive title<input name="title" required maxlength="160" value="<%= form.title||'' %>"></label><label>Role title<input name="role_title" required maxlength="120" value="<%= form.role_title||'' %>"></label>
<label>Package (LPA; full-time)<input name="package_lpa" type="number" min="0" step="0.01" value="<%= form.package_lpa||'' %>"></label><label>Monthly stipend (internship)<input name="stipend_monthly" type="number" min="0" step="0.01" value="<%= form.stipend_monthly||'' %>"></label>
<label>Minimum study year<input name="min_year" type="number" min="1" max="6" value="<%= form.min_year||4 %>"></label><label>Minimum CGPA (requires T5)<input name="min_cgpa" type="number" min="0" max="10" step="0.01" value="<%= form.min_cgpa||'' %>"></label><label>Maximum active backlogs (requires T5)<input name="max_active_backlogs" type="number" min="0" value="<%= form.max_active_backlogs||'' %>"></label><label>Minimum attendance %<input name="min_attendance_pct" type="number" min="0" max="100" step="0.01" value="<%= form.min_attendance_pct||'' %>"></label>
<label>Application opens<input name="opens_at" type="datetime-local" required value="<%= form.opens_at||'' %>"></label><label>Deadline<input name="deadline" type="datetime-local" required value="<%= form.deadline||'' %>"></label><label>Drive date<input name="drive_date" type="date" value="<%= form.drive_date||'' %>"></label><label>Status<select name="status"><option>Draft</option><option>Open</option><option>Closed</option><option>Cancelled</option></select></label>
<label class="wide">Eligible program IDs (comma separated; blank means all)<input name="program_ids" value="<%= form.program_ids||'' %>" placeholder="e.g. CSE-BTECH, IT-BTECH"><small><% programs.forEach(p=>{ %><%= p.program_id %> — <%= p.program_name %> · <% }) %></small></label>
<label class="wide">Description<textarea name="description" rows="4" maxlength="5000"><%= form.description||'' %></textarea></label><label class="wide">Location<input name="job_location" maxlength="120" value="<%= form.job_location||'' %>"></label><div class="wide"><button class="btn">Create drive</button></div></form>
<%- include('../partials/layout-end') %>
