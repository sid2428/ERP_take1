<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Course offerings</h1><span class="sub"><%= profile.program_name %> · Semester <%= fmt.roman(profile.semester) %> · <%= courses.length %> courses · <%= fmt.credits(totalCredits) %> credits</span></div>
<section class="card">
  <div class="hd"><h2>Courses this semester</h2><span class="muted">Your enrolled courses with their teacher, weekly hours and syllabus covered so far</span></div>
  <% if (!courses.length) { %>
    <p class="muted" style="margin-top:12px">No courses are enrolled for the current session.</p>
  <% } else { %>
  <div style="overflow-x:auto;margin-top:12px">
    <table>
      <thead>
        <tr><th>Code</th><th>Course</th><th>Type</th><th>Credits</th><th>L-T-P hrs</th><th>Teacher</th><th>Syllabus covered</th></tr>
      </thead>
      <tbody>
        <% for (const c of courses) { %>
          <% const cv = coverage.get(c.course_id); %>
          <tr>
            <td><%= c.course_code %><% if (c.is_honors) { %> <span class="pill v" style="font-size:10px">Honors</span><% } %></td>
            <td><%= c.course_name %></td>
            <td><%= c.course_type %></td>
            <td><%= fmt.credits(c.credits) %></td>
            <td><%= c.lecture_hrs %>-<%= c.tutorial_hrs %>-<%= c.practical_hrs %></td>
            <td><%= c.faculty_name || 'To be assigned' %></td>
            <td>
              <% if (cv) { %>
                <%- include('../partials/pct-bar', { value: cv.pct, min: 1 }) %>
                <span class="muted"><%= cv.units_done %> of <%= cv.units_total %> units done</span>
              <% } else { %>
                <span class="muted">Not started</span>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/layout-end') %>
