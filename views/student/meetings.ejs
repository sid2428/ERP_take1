<%- include('../partials/layout-start') %>

<div class="page-head">
  <h1>Department Meetings</h1>
  <span class="sub">Meetings and formal sessions scheduled for students by your Head of Department (<%= deptName || deptId %>)</span>
</div>

<% const nowIso = new Date().toISOString().slice(0, 10); %>
<% const upcomingCount = meetings.filter(m => m.meeting_date >= nowIso && m.status === 'SCHEDULED').length; %>

<section class="cards">
  <div class="card">
    <div class="hd"><h2>Total Department Meetings</h2><span class="pill"><%= meetings.length %></span></div>
    <div class="kpi"><%= meetings.length %> <small>recorded</small></div>
    <div class="sm">Sessions called by <%= deptId %> HOD</div>
  </div>
  <div class="card">
    <div class="hd"><h2>Upcoming Meetings</h2><span class="pill g"><%= upcomingCount %> active</span></div>
    <div class="kpi"><%= upcomingCount %> <small>scheduled</small></div>
    <div class="sm">Upcoming sessions requiring attendance</div>
  </div>
</section>

<section class="card t" style="margin-top:20px;">
  <div class="hd">
    <h2>Meeting Invitations</h2>
    <span class="note"><%= meetings.length %> meeting(s) for your department</span>
  </div>

  <% if (meetings.length === 0) { %>
    <div style="padding:28px 20px; text-align:center; color:var(--muted);">
      <p>No department meetings scheduled for your department at this time.</p>
    </div>
  <% } else { %>
    <div class="sc">
      <table class="tbl">
        <thead>
          <tr>
            <th>Date & Time</th>
            <th>Meeting Details</th>
            <th>Venue / Link</th>
            <th>Status</th>
            <th>My RSVP</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% for (const m of meetings) { %>
            <tr>
              <td>
                <strong><%= m.meeting_date %></strong><br>
                <small class="muted"><%= m.start_time %> - <%= m.end_time %></small>
              </td>
              <td>
                <strong><%= m.title %></strong>
                <p style="margin:4px 0 0; font-size:12px; color:var(--muted); max-width:340px;"><%= m.agenda %></p>
                <small class="muted">Called by: <%= m.created_by_name || 'HOD' %></small>
              </td>
              <td>
                <%= m.venue %>
                <% if (m.meeting_link) { %>
                  <br><a href="<%= m.meeting_link %>" target="_blank" rel="noopener noreferrer" style="font-size:12px; color:var(--navy);">Join Online</a>
                <% } %>
              </td>
              <td>
                <span class="pill <%= m.status === 'SCHEDULED' ? 'g' : (m.status === 'COMPLETED' ? 'n' : 'r') %>">
                  <%= m.status %>
                </span>
                <% if (m.cancel_reason) { %>
                  <br><small class="muted"><%= m.cancel_reason %></small>
                <% } %>
              </td>
              <td>
                <span class="pill <%= m.my_status === 'ACCEPTED' ? 'g' : (m.my_status === 'DECLINED' ? 'r' : 'o') %>">
                  <%= m.my_status || 'INVITED' %>
                </span>
              </td>
              <td>
                <% if (m.status === 'SCHEDULED') { %>
                  <div style="display:flex; gap:4px;">
                    <form method="post" action="/student/meetings/<%= m.meeting_id %>/rsvp">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="ACCEPTED">
                      <button type="submit" style="background:#E3F4EC; color:#1D6B4A; border:1px solid #B8E4D0; padding:4px 8px; border-radius:4px; font-size:11px; cursor:pointer;">
                        Accept
                      </button>
                    </form>
                    <form method="post" action="/student/meetings/<%= m.meeting_id %>/rsvp">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="DECLINED">
                      <button type="submit" style="background:#FBE7E5; color:#8E1B14; border:1px solid #F1C3C0; padding:4px 8px; border-radius:4px; font-size:11px; cursor:pointer;">
                        Decline
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/layout-end') %>
