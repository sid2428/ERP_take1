<%- include('../partials/layout-start') %>
<div class="page-head">
  <h1>Hall Ticket</h1>
  <span class="sub">Hall tickets are shown only for registered exams with at least 75% attendance.</span>
</div>
<section class="card hall-ticket-view" data-student-view="hall-ticket" aria-live="polite">
