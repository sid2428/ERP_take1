<%- include('../partials/layout-start') %>
<div class="page-head"><h1>Placement drives</h1><span class="sub">Eligibility is calculated from current academic data; missing GPA or backlog data is not assumed to pass.</span></div>
<form class="filters" method="get"><input name="q" value="<%= filters.q %>" placeholder="Search company or role"><select name="type"><option value="">All types</option><option value="FullTime" <%= filters.type==='FullTime'?'selected':'' %>>Full-time</option><option value="Internship" <%= filters.type==='Internship'?'selected':'' %>>Internship</option></select><select name="eligible"><option value="">Any eligibility</option><option value="yes" <%= filters.eligible==='yes'?'selected':'' %>>Eligible</option><option value="no" <%= filters.eligible==='no'?'selected':'' %>>Not eligible</option></select><button class="btn secondary">Filter</button></form>
<form class="filters" method="get"><input type="hidden" name="q" value="<%= filters.q %>"><input type="hidden" name="type" value="<%= filters.type %>"><input type="hidden" name="eligible" value="<%= filters.eligible %>"><label>Drives per page<select name="page_size"><% [10,20,50].forEach(size=>{ %><option value="<%= size %>" <%= pageSize===size?'selected':'' %>><%= size %></option><% }) %></select></label><button class="btn secondary">Update</button></form>
<p class="sub"><%= total %> matching drive<%= total===1?'':'s' %><% if (totalPages) { %> · Page <%= page %> of <%= totalPages %><% } %></p>
<% if (!drives.length) { %><div class="empty">No matching drives are available.</div><% } %>
<div class="stack"><% drives.forEach(d=>{ %><article class="card"><div class="row"><div><h2><a href="/student/placement/drives/<%= d.drive_id %>"><%= d.title %></a></h2><p><%= d.company_name %> · <%= d.role_title %> · <%= d.drive_type==='FullTime'?'Full-time':'Internship' %></p></div><span class="pill <%= d.eligible?'ok':'warn' %>"><%= d.eligible?'Eligible':'Not eligible' %></span></div><p><%= d.drive_type==='FullTime'?`${d.package_lpa} LPA`:`₹${fmt.num(d.stipend_monthly)} / month` %> · deadline <%= new Date(d.deadline).toLocaleString() %></p><% if (!d.eligible) { %><p class="note"><%= (d.reasons||[]).join(' · ') %></p><% } %><% if (d.applied) { %><span class="pill">Applied</span><% } %></article><% }) %></div>
<% if (totalPages>1) { const pageLink=(target)=>`?q=${encodeURIComponent(filters.q)}&type=${encodeURIComponent(filters.type)}&eligible=${encodeURIComponent(filters.eligible)}&page_size=${pageSize}&page=${target}`; %><nav class="actions" aria-label="Placement drive pages"><% if (page>1) { %><a class="btn secondary" rel="prev" href="<%= pageLink(page-1) %>">Previous</a><% } %><span>Page <%= page %> of <%= totalPages %></span><% if (page<totalPages) { %><a class="btn secondary" rel="next" href="<%= pageLink(page+1) %>">Next</a><% } %></nav><% } %>
<%- include('../partials/layout-end') %>
