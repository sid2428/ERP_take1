<%- include('../partials/layout-start') %>
<div class="page-head"><h1><%= drive.title %></h1><span class="sub"><%= drive.company_name %> · <%= drive.role_title %></span></div>
<section class="card"><p><%= drive.description %></p><p><strong>Type:</strong> <%= drive.drive_type==='FullTime'?'Full-time':'Internship' %> · <strong>Compensation:</strong> <%= drive.drive_type==='FullTime'?`${drive.package_lpa} LPA`:`₹${fmt.num(drive.stipend_monthly)} / month` %></p><p><strong>Location:</strong> <%= drive.job_location || 'Not specified' %> · <strong>Deadline:</strong> <%= new Date(drive.deadline).toLocaleString() %></p><p><strong>Minimum year:</strong> <%= drive.min_year %> · <strong>Minimum CGPA:</strong> <%= drive.min_cgpa ?? 'Not required' %> · <strong>Maximum backlogs:</strong> <%= drive.max_active_backlogs ?? 'Not required' %></p><p><strong>Programs:</strong> <%= drive.programs.length?drive.programs.join(', '):'All programs' %></p>
<% if (application) { %><span class="pill">Application submitted</span><% } else if (drive.eligible) { %><form method="post" action="/student/placement/drives/<%= drive.drive_id %>/apply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Apply</button></form><% } else { %><p class="flash info"><%= (drive.reasons||[]).join(' · ') %></p><% } %></section>
<%- include('../partials/layout-end') %>
